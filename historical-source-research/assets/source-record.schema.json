{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical Source Record",
  "type": "object",
  "required": [
    "record_id",
    "document_title_original",
    "document_title_translation",
    "document_date",
    "document_date_precision",
    "document_date_raw",
    "calendar",
    "document_type",
    "creator",
    "recipient",
    "language",
    "source_category",
    "original_repository",
    "online_host",
    "digital_producer",
    "fonds_or_collection",
    "series",
    "file_unit",
    "item_identifier",
    "archive_reference",
    "original_page_or_folio",
    "printed_page",
    "pdf_page",
    "digital_image_page",
    "catalogue_url",
    "fulltext_url",
    "digital_image_url",
