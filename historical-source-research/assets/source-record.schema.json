      "type": "string",
      "minLength": 1
    },
    "document_title_original": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_title_translation": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_date_precision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "day",
        "month",
        "year",
        "range",
        "circa",
        "historical",
        "unknown",
        null
      ]
    },
    "document_date_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "calendar": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "creator": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipient": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "original",
        "edited_primary",
        "contemporary_public",
        "finding_aid",
        "secondary",
        "memoir",
        "unverified",
        null
      ]
    },
    "original_repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "online_host": {
      "type": [
        "string",
        "null"
      ]
    },
    "digital_producer": {
      "type": [
        "string",
        "null"
      ]
    },
    "fonds_or_collection": {
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "item_identifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "archive_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_page_or_folio": {
      "type": [
        "string",
        "null"
      ]
    },
    "printed_page": {
      "type": [
        "string",
        "null"
      ]
    },
    "pdf_page": {
      "type": [
        "string",
        "null"
      ]
    },
    "digital_image_page": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalogue_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "fulltext_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "digital_image_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_text_excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "excerpt_translation": {
      "type": [
        "string",
        "null"
      ]
    },
    "excerpt_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "excerpt_verification_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "image_verified",
        "fulltext_verified",
        "unverified",
        "none",
        null
      ]
    },
    "metadata_verification_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "verified",
        "partial",
        "unverified",
        null
      ]
    },
    "document_access_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "image",
        "fulltext",
        "catalogue_only",
        "search_only",
        "denied",
        "unavailable",
        "offline",
        "unknown",
        null
      ]
    },
    "content_verification_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "image_verified",
        "fulltext_verified",
        "metadata_only",
        "search_lead",
        "unverified",
        null
      ]
    },
    "traceability_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "complete_chain",
        "partial_chain",
        "stable_record",
        "untraceable",
        null
      ]
    },
    "research_relevance": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_criticism": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "declassification_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "digitization_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "edition_identifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "original",
        "copy",
        "transcription",
        "translation",
        "edited",
        "abridged",
        "unknown",
        null
      ]
    },
    "independence_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "supported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictory_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_simulation": {
      "type": "boolean"
    },
    "citation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "simulation",
            "catalogue_record"
          ]
        },
        "first_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "short_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "bibliography": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "publication": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "type": [
            "string",
            "null"
          ]
        },
        "editor": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "place": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "newspaper": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "un_symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "meeting_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actually_checked",
          "locator",
          "method",
          "checked_at",
          "result"
        ],
        "properties": {
          "actually_checked": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "catalogue",
              "fulltext",
              "image",
              "edition",
              "user_supplied",
              "search"
            ]
          },
          "checked_at": {
            "type": "string"
          },
          "result": {
            "enum": [
              "verified",
              "partial",
              "unverified",
              "denied",
              "unavailable"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "claim_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "stance",
          "proof_value",
          "basis"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "stance": {
            "enum": [
              "support",
              "contradict",
              "partial",
              "undetermined",
              "expected_missing"
            ]
          },
          "proof_value": {
            "enum": [
              "direct",
              "indirect",
              "counterevidence",
              "undetermined"
            ]
          },
          "basis": {
            "type": "string"
          },
          "limitations": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "body_content_verified": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
